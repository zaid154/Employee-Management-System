# ---- Server ----
PORT=5002
MONGO_URI=mongodb://127.0.0.1:27017/ems_payroll
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ---- Email / SMTP / Brevo (OTP & Notifications) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_sender_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
BREVO_API_KEY=your_brevo_api_key_for_failover

# ---- Cloudinary (Profile Photos & Document Verification) ----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# First admin created by `npm run seed`
SEED_ADMIN_NAME=HR Admin
SEED_ADMIN_EMAIL=admin@ems.dev
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Client (client/.env) ----
# VITE_API_URL=/api
